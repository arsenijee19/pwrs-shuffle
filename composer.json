{
  "name": "playworld/mystery-box",
  "description": "PlayWorld Mystery Box MVP standalone PHP application.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "chillerlan/php-qrcode": "^5.0",
    "dompdf/dompdf": "^3.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2"
  },
  "autoload": {
    "psr-4": {
      "PlayWorld\\MysteryBox\\": "app/"
    },
    "files": [
      "app/Support/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "PlayWorld\\MysteryBox\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": "php bin/setup.php",
    "migrate": "php bin/migrate.php",
    "seed:admin": "php bin/create-admin.php",
    "test": "phpunit",
    "lint": "php -l public/index.php && find app bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
