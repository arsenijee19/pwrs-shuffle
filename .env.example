APP_NAME="PlayWorld Mystery Box"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mystery.playworld.rs
APP_TIMEZONE=Europe/Belgrade

DB_PATH=storage/database/playworld.sqlite

