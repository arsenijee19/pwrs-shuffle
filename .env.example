APP_NAME="PlayWorld Mystery Box"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mystery.playworld.rs
APP_TIMEZONE=Europe/Belgrade

DB_PATH=storage/database/playworld.sqlite

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-launch

SESSION_NAME=playworld_mystery
SESSION_SECURE=true
RESULT_RETENTION_DAYS=5
RATE_LIMIT_PER_MINUTE=60
APP_QUERY_ROUTES=false
APP_KEY=replace-with-a-long-random-secret

# Anti-repeat protection. Do not use the raw IP in the database.
ANTI_REPEAT_ENABLED=true
ANTI_REPEAT_WINDOW_MINUTES=60
ANTI_REPEAT_SECRET=replace-with-a-second-long-random-secret
TRUST_CLOUDFLARE=false
DISCOUNT_LOW_STOCK_THRESHOLD=10

# n8n / order fulfillment API
API_ENABLED=false
N8N_API_KEY=
PWRS_N8N_API_KEY=
N8N_API_MAX_QUANTITY=20
N8N_API_RATE_LIMIT_PER_MINUTE=30

MAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
MAIL_FROM=usluge@playworld.rs
MAIL_FROM_NAME="PlayWorld"
MAIL_TIMEOUT=15
